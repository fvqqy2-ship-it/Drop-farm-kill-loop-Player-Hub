createButton("Get and Drop VIP", Home1Page, UDim2.new(0, 10, 0, 10), UDim2.new(0, 280, 0, 50), Color3.fromRGB(0, 100, 200), function()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local backpack = LocalPlayer.Backpack
    local humanoidRootPart = character.HumanoidRootPart
    local originalPosition = humanoidRootPart.CFrame

    local locations = {
        CFrame.new(-82, 17634, 9046),
        CFrame.new(-95, 17634, 9046),
        CFrame.new(-124, 17634, 9046)
    }

    for _, position in ipairs(locations) do
        humanoidRootPart.CFrame = position
        task.wait(0.5)
    end

    humanoidRootPart.CFrame = originalPosition
    task.wait(0.3)

    for _, tool in ipairs(character:GetChildren()) do
        if tool:IsA("Tool") then
            tool.Parent = backpack
        end
    end
    task.wait(0.3)

    local itemsToProcess = {"EpicKatana", "FreezeRay", "Fusion Coil"}
    for _, toolName in ipairs(itemsToProcess) do
        local tool = backpack:FindFirstChild(toolName)
        if tool then
            tool.Parent = character
            task.wait(0.1)
            tool.Parent = Workspace
        end
    end
end)

local killFarmActive = false
createButton("Toggle Kill Farm Loop", Home1Page, UDim2.new(0, 10, 0, 75), UDim2.new(0, 280, 0, 40), Color3.fromRGB(180, 0, 0), function(btn)
    killFarmActive = not killFarmActive
    if killFarmActive then
        btn.BackgroundColor3 = Color3.fromRGB(0, 180, 0)
        task.spawn(function()
            while killFarmActive do
                local myChar = LocalPlayer.Character
                if myChar and myChar:FindFirstChild("HumanoidRootPart") then
                    local weapon = myChar:FindFirstChildOfClass("Tool") or LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
                    if weapon and weapon.Parent == LocalPlayer.Backpack then
                        weapon.Parent = myChar
                    end

                    for _, enemy in ipairs(Players:GetPlayers()) do
                        if not killFarmActive then break end
                        if enemy ~= LocalPlayer and enemy.Character and enemy.Character:FindFirstChild("HumanoidRootPart") and enemy.Character:FindFirstChild("Humanoid") then
                            if enemy.Character.Humanoid.Health > 0 and myChar:FindFirstChild("HumanoidRootPart") then
                                myChar.HumanoidRootPart.CFrame = enemy.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
                                if weapon then
                                    task.defer(function()
                                        weapon:Activate()
                                    end)
                               end
                                task.wait(0.2)
                            end
                        end
                    end
                end
                task.wait(0.5)
            end
        end)
    else
        btn.BackgroundColor3 = Color3.fromRGB(180, 0, 0)
    end
end)


